{
  "name": "easy-eat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "npm --prefix easy-eat-front run build && node scripts/build-worker.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/local-server.mjs",
    "preview": "node scripts/local-server.mjs",
    "sync:status": "node scripts/sync-repositories.mjs status",
    "sync:pull": "node scripts/sync-repositories.mjs pull",
    "sync:push": "node scripts/sync-repositories.mjs push",
    "protect:check": "node scripts/protect-main.mjs check",
    "protect:apply": "node scripts/protect-main.mjs apply",
    "release:check": "node scripts/release.mjs check",
    "release:start": "node scripts/release.mjs start",
    "release:finish": "node scripts/release.mjs finish"
  }
}
